#!/usr/bin/env bash
set -euo pipefail

# Symlink dotagents content into each agent's config dir.
#
# Source of truth:
#   AGENTS.md  -> ~/.claude/CLAUDE.md  (Claude reads CLAUDE.md, not AGENTS.md)
#   AGENTS.md  -> ~/.codex/AGENTS.md   (Codex reads AGENTS.md directly)
#   skills/*   -> ~/.claude/skills/*   (only if skills/ is present;
#                                       populated by the release tarball)
#
# Usage: bin/setup [--dry-run]

readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly CLAUDE_DIR="${HOME}/.claude"
readonly CODEX_DIR="${HOME}/.codex"

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) sed -n '3,13p' "$0"; exit 0 ;;
    *) echo "unknown arg: $arg" >&2; exit 2 ;;
  esac
done

link() {
  local src="$1" dest="$2"

  if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
    echo "ok    $dest"
    return
  fi

  if [[ -e "$dest" || -L "$dest" ]]; then
    echo "skip  $dest (exists, not managed by dotagents)"
    return
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "plan  $dest -> $src"
    return
  fi

  mkdir -p "$(dirname "$dest")"
  ln -s "$src" "$dest"
  echo "link  $dest -> $src"
}

link_dir_children() {
  local src_dir="$1" dest_dir="$2"
  [[ -d "$src_dir" ]] || return 0
  shopt -s nullglob
  for entry in "$src_dir"/*; do
    link "$entry" "$dest_dir/$(basename "$entry")"
  done
  shopt -u nullglob
}

link "${REPO_ROOT}/AGENTS.md"             "${CLAUDE_DIR}/CLAUDE.md"
link "${REPO_ROOT}/AGENTS.md"             "${CODEX_DIR}/AGENTS.md"
link_dir_children "${REPO_ROOT}/skills"   "${CLAUDE_DIR}/skills"
